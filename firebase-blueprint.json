{
  "entities": {
    "User": {
      "title": "User",
      "description": "A farmer using the app",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "createdAt"]
    },
    "Batch": {
      "title": "Batch",
      "description": "A batch of broiler chickens",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "batchName": { "type": "string" },
        "startDate": { "type": "string" },
        "totalChicks": { "type": "number" },
        "costPerChick": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "batchName", "startDate", "totalChicks", "status", "createdAt"]
    },
    "FeedRecord": {
      "title": "FeedRecord",
      "description": "Feed consumption record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "batchId": { "type": "string" },
        "date": { "type": "string" },
        "feedType": { "type": "string" },
        "quantityBags": { "type": "number" },
        "cost": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "batchId", "date", "quantityBags", "cost", "createdAt"]
    },
    "MedicineRecord": {
      "title": "MedicineRecord",
      "description": "Medicine or Vaccine usage",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "batchId": { "type": "string" },
        "date": { "type": "string" },
        "medicineName": { "type": "string" },
        "type": { "type": "string", "enum": ["medicine", "vaccine"] },
        "cost": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "batchId", "date", "medicineName", "type", "cost", "createdAt"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Daily/Other expenses",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "batchId": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "details": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "batchId", "date", "amount", "createdAt"]
    },
    "Mortality": {
      "title": "Mortality",
      "description": "Number of dead chickens",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "batchId": { "type": "string" },
        "date": { "type": "string" },
        "count": { "type": "number" },
        "cause": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "batchId", "date", "count", "createdAt"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Chicken sales record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "batchId": { "type": "string" },
        "date": { "type": "string" },
        "totalWeightKg": { "type": "number" },
        "pricePerKg": { "type": "number" },
        "totalAmount": { "type": "number" },
        "buyerName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "batchId", "date", "totalWeightKg", "pricePerKg", "totalAmount", "createdAt"]
    },
    "Due": {
      "title": "Due",
      "description": "Outstanding dues / payments",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "personName": { "type": "string" },
        "phone": { "type": "string" },
        "type": { "type": "string", "enum": ["payable", "receivable"] },
        "amount": { "type": "number" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "paid"] },
        "recordDate": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "personName", "type", "amount", "status", "createdAt"]
    },
    "StoreListing": {
      "title": "StoreListing",
      "description": "Agro and Vet Feed and Medicine Store Directory",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "shopName": { "type": "string" },
        "ownerName": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "district": { "type": "string" },
        "upazila": { "type": "string" },
        "address": { "type": "string" },
        "categories": { "type": "array" },
        "availableBrands": { "type": "string" },
        "productsOffered": { "type": "string" },
        "hasHomeDelivery": { "type": "boolean" },
        "openHours": { "type": "string" },
        "imageUrl": { "type": "string" },
        "isVerified": { "type": "boolean" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "shopName", "phone", "district", "address", "createdAt"]
    },
    "SubscriptionPlan": {
      "title": "SubscriptionPlan",
      "description": "Admin configured subscription plan or ad tier",
      "type": "object",
      "properties": {
        "nameBn": { "type": "string" },
        "nameEn": { "type": "string" },
        "type": { "type": "string", "enum": ["farmer_premium", "business_ad"] },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "durationDays": { "type": "number" },
        "durationLabelBn": { "type": "string" },
        "durationLabelEn": { "type": "string" },
        "featuresBn": { "type": "array" },
        "featuresEn": { "type": "array" },
        "isPopular": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["nameBn", "type", "price", "durationDays", "isActive", "createdAt"]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "Manual payment submission by user awaiting admin review",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "userEmail": { "type": "string" },
        "planId": { "type": "string" },
        "planTitle": { "type": "string" },
        "planType": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "senderPhone": { "type": "string" },
        "trxId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminNotes": { "type": "string" },
        "createdAt": { "type": "string" },
        "processedAt": { "type": "string" }
      },
      "required": ["userId", "planId", "amount", "paymentMethod", "senderPhone", "trxId", "status", "createdAt"]
    },
    "UserSubscription": {
      "title": "UserSubscription",
      "description": "User active VIP subscription record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userIdentifier": { "type": "string" },
        "planId": { "type": "string" },
        "planType": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "expired", "revoked"] },
        "isLifetime": { "type": "boolean" },
        "startDate": { "type": "string" },
        "expiresAt": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "trxId": { "type": "string" },
        "grantedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "status", "startDate", "createdAt"]
    },
    "SponsorPartner": {
      "title": "SponsorPartner",
      "description": "Sponsored feed, medicine, and business ad banner",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nameEn": { "type": "string" },
        "category": { "type": "string" },
        "tagline": { "type": "string" },
        "taglineEn": { "type": "string" },
        "badge": { "type": "string" },
        "badgeEn": { "type": "string" },
        "hotline": { "type": "string" },
        "benefits": { "type": "array" },
        "popularProducts": { "type": "array" },
        "accentColor": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "category", "hotline", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles"
    },
    "batches/{batchId}": {
      "schema": { "$ref": "Batch" },
      "description": "Chicken batches"
    },
    "feed_records/{recordId}": {
      "schema": { "$ref": "FeedRecord" },
      "description": "Feed consumption records"
    },
    "medicine_records/{recordId}": {
      "schema": { "$ref": "MedicineRecord" },
      "description": "Medicine and vaccine records"
    },
    "expenses/{expenseId}": {
      "schema": { "$ref": "Expense" },
      "description": "Daily expense records"
    },
    "mortality/{recordId}": {
      "schema": { "$ref": "Mortality" },
      "description": "Mortality records"
    },
    "sales/{saleId}": {
      "schema": { "$ref": "Sale" },
      "description": "Chicken sales"
    },
    "dues/{dueId}": {
      "schema": { "$ref": "Due" },
      "description": "Tracking dues payable or receivable"
    },
    "store_listings/{listingId}": {
      "schema": { "$ref": "StoreListing" },
      "description": "Agro & Vet feed and medicine store listings"
    },
    "subscription_plans/{planId}": {
      "schema": { "$ref": "SubscriptionPlan" },
      "description": "Subscription plans and ad tiers"
    },
    "payment_requests/{requestId}": {
      "schema": { "$ref": "PaymentRequest" },
      "description": "User payment submission records"
    },
    "subscriptions/{userId}": {
      "schema": { "$ref": "UserSubscription" },
      "description": "Active user subscription document"
    },
    "sponsors/{sponsorId}": {
      "schema": { "$ref": "SponsorPartner" },
      "description": "Sponsored company ad banners"
    }
  }
}
