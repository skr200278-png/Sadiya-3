rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'skabusufian452@gmail.com' ||
        request.auth.token.email == 'sr0632890@gmail.com'
      );
    }

    // Users Collection - public profile read, strictly owner-only write
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role != 'admin') &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
      allow update: if (isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.get('role', 'user')) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.get('isAdmin', false)))
        || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Batches
    match /batches/{batchId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin());
    }

    // Daily Actual Records (Batch-Scoped Daily Logs)
    match /daily_actual_records/{recordId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin());
    }

    // Feed Records
    match /feed_records/{recordId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin());
    }

    // Medicine Records
    match /medicine_records/{recordId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin());
    }

    match /medicine/{recordId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin());
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin());
    }

    // Mortality
    match /mortality/{recordId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin());
    }

    // Sales
    match /sales/{saleId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin());
    }

    // Weight Records
    match /weight_records/{recordId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin());
    }

    // Dues / Khata
    match /dues/{dueId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin());
    }

    // Chores / Reminders
    match /chores/{choreId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin());
    }

    // Marketplace Sell Posts
    match /marketplace_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId) || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Market Buyers Directory
    match /market_buyers/{buyerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId) || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Doctor Consultations / Prescription Requests
    match /consultations/{consultationId} {
      allow read, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || isAdmin());
    }

    // Community Doctor Listings / Advertisements
    match /doctor_listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId) || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Agro & Vet Feed & Medicine Store Directory Listings
    match /store_listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId) || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Hatchery Chick, Fingerling & Seedling Market Listings & Ads
    match /chick_listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && ((resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId) || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Benchmark Chick & DOC Market Rates (A, B, C Grades)
    match /chick_rates/{rateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Subscription Plans & Ad Tiers
    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Manual Payment Requests Submitted by Users
    match /payment_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid &&
        (!('status' in request.resource.data) || request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }

    // Active User Subscriptions (Checked by user & updated by admin)
    match /subscriptions/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_subscriptions/{subId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sponsored Partners & Advertisement Banners
    match /sponsors/{sponsorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Settings & Feature Controls
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Config (Market & Feature Settings)
    match /system_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}

