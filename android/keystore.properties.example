# Example Keystore configuration for Release / Play Store builds
# DO NOT commit real passwords or keystore files to source control!
# Copy this file or set these via Environment Variables / ~/.gradle/gradle.properties

# Path relative to android/app or absolute path
RELEASE_STORE_FILE=../my-release-key.keystore
RELEASE_STORE_PASSWORD=your_keystore_password_here
RELEASE_KEY_ALIAS=your_key_alias_here
RELEASE_KEY_PASSWORD=your_key_password_here
